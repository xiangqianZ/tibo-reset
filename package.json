  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-xml-parser": "5.11.2",
    "htmlparser2": "12.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
